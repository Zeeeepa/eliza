{
  "name": "@elizaos/plugin-anthropic-enhanced",
  "version": "1.0.0",
  "description": "Enhanced Anthropic Claude API integration for ElizaOS with comprehensive testing, streaming, rate limiting, and cost tracking",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "elizaos",
    "anthropic",
    "claude",
    "ai",
    "llm",
    "streaming",
    "plugin"
  ],
  "author": "ElizaOS Contributors",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@elizaos/core": "workspace:*",
    "p-retry": "^6.2.1",
    "p-queue": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  }
}

