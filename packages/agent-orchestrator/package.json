{
  "name": "@elizaos/agent-orchestrator",
  "version": "0.1.0",
  "description": "Multi-agent orchestration system for automated software development",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun run src/server/index.ts",
    "start:dev": "bun --watch run src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-bootstrap": "workspace:*",
    "@elizaos/plugin-github": "workspace:*",
    "@elizaos/plugin-node": "workspace:*",
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "glob": "^10.3.10",
    "simple-git": "^3.22.0",
    "@babel/parser": "^7.23.9",
    "ts-morph": "^21.0.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.19.1",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "prettier": "^3.2.4",
    "esbuild": "^0.19.12",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/bun": "latest",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0"
  },
  "keywords": [
    "elizaos",
    "agent",
    "orchestrator",
    "multi-agent",
    "automation",
    "software-development"
  ],
  "author": "ElizaOS Contributors",
  "license": "MIT"
}
